{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:analyzer",
  "outputDirectory": "frontend",
  "functions": {
    /* All API routes – Serverless Functions */
    "frontend/app/api/**/*.js": {
      "runtime": "nodejs20.x"
    },
    /* The heavy‑weight analysis worker – Background Function */
    "frontend/app/api/scans/[scanId]/analyze/route.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 270         // 15 seconds × 60 = 15 minutes
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/frontend/app/api/$1" },
    { "source": "/(.*)", "destination": "/frontend/app/page.tsx" }
  ]
}
